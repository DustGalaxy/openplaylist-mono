resolver 127.0.0.11 valid=5s;

# --- ГЛАВНЫЙ БЛОК SERVER ---
server {
    listen 3000;
    server_name $DOMAIN;
    client_header_timeout 120s;
    
    # Таймаут на получение тела запроса от клиента (важно для больших POST/PUT запросов)
    client_body_timeout 120s;
    
    # Таймаут на передачу ответа клиенту
    send_timeout 120s;
    # --- Обслуживание React Приложения ---
    root /usr/share/nginx/html;
    index index.html;

    # Блок для статических файлов React и React Router
    location / {
        # Важно для React Router (HTML5 History API)
        try_files $uri $uri/ /index.html;
    }

    # --- Проксирование API (Auth Service) ---
    location /api/v1/auth/ {
        rewrite ^/api/v1/auth/(.*)$ /$1 break;
        
        # Проксируем на имя UPSTREAM-блока
        proxy_pass $HOST_AUTH_SERVICE; 

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # --- Проксирование API (Playlist Service) ---
    location /api/v1/playlist/ {
        rewrite ^/api/v1/playlist/(.*)$ /$1 break;
        
        proxy_pass $HOST_PLAYLIST_SERVICE;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Проксирование API (Order Service) ---
    location /api/v1/order/ {
        rewrite ^/api/v1/order/(.*)$ /$1 break;
        
        proxy_pass $HOST_ORDER_SERVICE; 

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- Проксирование WebSocket (Socket Service) ---
    location /socket.io/ {
        proxy_pass $HOST_SOCKET_SERVICE; 

        # Настройки для WebSocket

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}