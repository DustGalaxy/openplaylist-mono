# ==========================================
# OpenPlaylist DonatePay Bot Configuration
# ==========================================

DONATEPAY_ACCESS_TOKEN="your_donatepay_access_token"
DONATEPAY_CHANNEL="$public:your_channel_id"
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/"
RABBITMQ_QUEUE="donatepay_events"

# Optional endpoints (defaults will be used if omitted)
# DONATEPAY_TOKEN_URL=https://donatepay.ru/api/v2/socket/token
# DONATEPAY_WS_URL=wss://centrifugo.donatepay.ru:443/connection/websocket
