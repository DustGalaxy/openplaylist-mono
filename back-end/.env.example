# ==========================================
# OpenPlaylist Backend Environment Config
# ==========================================

# RSA256 Keys for JWT Session Signing (Generate via: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_SECRET_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_RSA_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# Application Mode (dev | prod)
MODE="dev"
PROJECT_DOMAIN="openplaylist.localhost"

# Admin Credentials
ADMIN_PASSWORD="change_me_super_secret_admin_password"
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=4$example_salt_hash_placeholder"

# Infrastructure Connections
DB_URL="postgresql+asyncpg://user:password@database:5432/openplaylist_db"
RABBITMQ_URL="amqp://user:password@rabbitmq:5672/"
REDIS_URL="redis://redis:6379"

# Email Delivery (SMTP)
SMTP_SERVER="smtp.example.com"
SMTP_PORT=587
SMTP_EMAIL_ADDRESS="noreply@openplaylist.local"
SMTP_EMAIL_PASSWORD="your_smtp_app_password"

# Platform Integrations & OAuth Clients
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"

DA_APP_ID="your_donationalerts_app_id"
DA_API_KEY="your_donationalerts_api_key"

GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
YOUTUBE_API_KEY="your_youtube_data_api_v3_key"

DONATEX_CLIENT_ID="your_donatex_client_id"
DONATEX_CLIENT_SECRET="your_donatex_client_secret"

# Server Host & Logging Settings
SELF_HOST="0.0.0.0"
SELF_PORT=8000
SELF_LOG_LEVEL="info"
SELF_RELOAD=True
