    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-http-backend": "^4.0.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vue3-ytframe": "^1.0.0",
