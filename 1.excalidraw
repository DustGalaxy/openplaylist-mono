      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1352260024,
      "version": 166,
      "versionNonce": 610737336,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773317072405,
      "link": null,
      "locked": false,
      "text": "Подключение стороних API для прийома заказов\n\n--Twitch--\n\n--Da--\n\nDonateX\n\nYoutube\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Подключение стороних API для прийома заказов\n\n--Twitch--\n\n--Da--\n\nDonateX\n\nYoutube\n\n",
      "autoResize": true,
