    },
    {
      "id": "QbkKAj8uDnGvwADgwKYgW",
      "type": "text",
      "x": 1597.1964625685757,
      "y": 1209.4586212856384,
      "width": 533.11962890625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Y",
      "roundness": null,
      "seed": 828672952,
      "version": 522,
      "versionNonce": 225259448,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773317463827,
      "link": null,
      "locked": false,
      "text": "Создание подписки, общая идея монитизации сервиса\n\nПодписка может включать:\n\n1. Больше возможных плейлистов\n2. Кастомизация внешнего вида\n3. Прийом заказов с расширенного числа иточников \n - донаты\n - баллы канала (twitch)\n или другие, но идея сомнительная\n4. Совместное управление плейлистом\n5. Разделение правил и их значений для разных ролей",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Создание подписки, общая идея монитизации сервиса\n\nПодписка может включать:\n\n1. Больше возможных плейлистов\n2. Кастомизация внешнего вида\n3. Прийом заказов с расширенного числа иточников \n - донаты\n - баллы канала (twitch)\n или другие, но идея сомнительная\n4. Совместное управление плейлистом\n5. Разделение правил и их значений для разных ролей",
      "autoResize": true,
      "lineHeight": 1.25
    },
