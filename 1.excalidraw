    {
      "id": "demK1nLWvofpVBobMzAxw",
      "type": "text",
      "x": 7613.191458444746,
      "y": 2365.505998762826,
      "width": 816.759521484375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
