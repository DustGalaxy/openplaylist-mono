    {
      "id": "znH3s4wht7jGiz_fN90y5",
      "type": "text",
      "x": 2135.000982254273,
      "y": 1969.9702844771114,
      "width": 859.1795043945312,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1U",
      "roundness": null,
      "seed": 2043465416,
      "version": 684,
      "versionNonce": 2017597128,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773317272572,
      "link": null,
      "locked": false,
      "text": "Идеи \n\nТеги для плейлистов\n\nСовмествое управление\n - Нужны permisions и их проверка при выполнении действий для корректной реализации\n\nКастомизация внешнего вида\n - настройки внешнего вида в отдельной моделе с привязкой к Основным настройкам\n - реализация на фронт-енде через css-variabels\n\nПриминение различных правил и их значений для разных ролей\n - хранение наборов правил для каждой роли\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Идеи \n\nТеги для плейлистов\n\nСовмествое управление\n - Нужны permisions и их проверка при выполнении действий для корректной реализации\n\nКастомизация внешнего вида\n - настройки внешнего вида в отдельной моделе с привязкой к Основным настройкам\n - реализация на фронт-енде через css-variabels\n\nПриминение различных правил и их значений для разных ролей\n - хранение наборов правил для каждой роли\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xx7PvfzS2r40tOCcj86hv",
      "type": "text",
      "x": 1584.3972976569435,
      "y": 1976.4744925826012,
      "width": 478.1796875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
